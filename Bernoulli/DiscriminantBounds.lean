/-!
# Discriminant bounds from bounded conjugates

The Vandermonde formula bounds the discriminant of a power basis in terms of
the norm of its conjugates. The field discriminant inherits the bound for an
integral power basis by the change-of-basis formula.
-/

public section

open NumberField Polynomial
open scoped BigOperators

namespace Bernoulli

/-- A power basis whose generator has conjugates of norm at most `N` has
discriminant of norm at most `(2 * N) ^ (d * (d - 1))`, where `d` is its degree. -/
theorem norm_powerBasis_discr_le {K : Type*} [Field K] [NumberField K]
    (B : PowerBasis ℚ K) {N : ℝ}
    (hconj : ∀ σ : K →ₐ[ℚ] ℂ, ‖σ B.gen‖ ≤ N) :
    ‖(algebraMap ℚ ℂ) (Algebra.discr ℚ B.basis)‖ ≤ (2 * N) ^ (B.dim * (B.dim - 1)) := by
  classical
  let e : Fin B.dim ≃ (K →ₐ[ℚ] ℂ) := Fintype.equivOfCardEq (by
    rw [Fintype.card_fin, AlgHom.card]
    exact B.finrank.symm)
  rw [Algebra.discr_powerBasis_eq_prod'' ℚ ℂ B e,
    Finset.prod_prod_Ioi_mul_eq_prod_prod_off_diag]
  rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
  simp_rw [Complex.norm_prod]
  have hpair (j i : Fin B.dim) : ‖e j B.gen - e i B.gen‖ ≤ 2 * N := by
    calc
      _ ≤ ‖e j B.gen‖ + ‖e i B.gen‖ := norm_sub_le _ _
      _ ≤ N + N := add_le_add (hconj _) (hconj _)
      _ = _ := (two_mul _).symm
  have hcard (i : Fin B.dim) : ({i}ᶜ : Finset (Fin B.dim)).card = B.dim - 1 := by
    simp [Finset.card_compl]
  calc
    _ ≤ ∏ i : Fin B.dim, ∏ _j ∈ ({i}ᶜ : Finset (Fin B.dim)), (2 * N) := by
      apply Finset.prod_le_prod₀
      · exact fun i _ => Finset.prod_nonneg fun j _ => norm_nonneg _
      · exact fun i _ => Finset.prod_le_prod₀ (fun j _ => norm_nonneg _) (fun j _ => hpair j i)
    _ = _ := by
      simp only [Finset.prod_const, hcard, Finset.card_univ, Fintype.card_fin]
      rw [← pow_mul, Nat.mul_comm]

/-- The field discriminant of an integral power basis with bounded conjugates
satisfies the logarithmic bound in terms of the field degree. -/
theorem log_abs_fieldDiscr_le_of_bounded_conjugates {K : Type*} [Field K] [NumberField K]
    (B : PowerBasis ℚ K) (θ : 𝓞 K) (hgen : B.gen = (θ : K)) {N : ℝ}
    (hconj : ∀ σ : K →ₐ[ℚ] ℂ, ‖σ B.gen‖ ≤ N) :
    Real.log |(NumberField.discr K : ℝ)| ≤
      (Module.finrank ℚ K * (Module.finrank ℚ K - 1) : ℕ) * Real.log (2 * N) := by
  obtain ⟨a, ha⟩ := exists_powerBasis_discriminant_eq_fieldDiscr_mul_sq B θ hgen
  have ha0 : a ≠ 0 := by
    intro h
    apply Algebra.discr_not_zero_of_basis ℚ B.basis
    rw [ha, h]
    simp
  have h1 : 1 ≤ ‖(a : ℂ)‖ := by
    rw [Complex.norm_intCast, ← Int.cast_abs]
    exact_mod_cast Int.one_le_abs ha0
  have hnorm : |(NumberField.discr K : ℝ)| ≤
      ‖(algebraMap ℚ ℂ) (Algebra.discr ℚ B.basis)‖ := by
    rw [ha]
    change _ ≤ ‖(((NumberField.discr K * a ^ 2 : ℤ) : ℚ) : ℂ)‖
    push_cast
    rw [norm_mul, norm_pow, Complex.norm_intCast (NumberField.discr K)]
    exact le_mul_of_one_le_right (abs_nonneg _) (one_le_pow₀ h1)
  have hpos : 0 < |(NumberField.discr K : ℝ)| := by
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  calc
    _ ≤ Real.log ((2 * N) ^ (B.dim * (B.dim - 1))) :=
      Real.log_le_log hpos (hnorm.trans (norm_powerBasis_discr_le B hconj))
    _ = _ := by rw [Real.log_pow, ← B.finrank]

/-- A number field generated by a root of the characteristic polynomial of a
matrix with entries of norm at most `1` satisfies the discriminant bound with
`N` equal to the size of the matrix. -/
theorem log_abs_fieldDiscr_le_of_minpoly_dvd_charpoly {K ι : Type*} [Field K] [NumberField K]
    [Fintype ι] [DecidableEq ι] (B : PowerBasis ℚ K) (θ : 𝓞 K) (hgen : B.gen = (θ : K))
    (A : Matrix ι ι ℂ) (hA : ∀ i j, ‖A i j‖ ≤ 1)
    (hdiv : (minpoly ℚ B.gen).map (algebraMap ℚ ℂ) ∣ A.charpoly) :
    Real.log |(NumberField.discr K : ℝ)| ≤ (Module.finrank ℚ K * (Module.finrank ℚ K - 1) : ℕ) *
      Real.log (2 * Fintype.card ι) := by
  refine log_abs_fieldDiscr_le_of_bounded_conjugates B θ hgen fun σ => ?_
  apply norm_le_card_of_isRoot_charpoly A hA
  have hz : ((minpoly ℚ B.gen).map (algebraMap ℚ ℂ)).eval (σ B.gen) = 0 := by
    rw [Polynomial.eval_map_algebraMap, Polynomial.aeval_algHom_apply σ, minpoly.aeval, map_zero]
  obtain ⟨g, hg⟩ := hdiv
  rw [Polynomial.IsRoot.def, hg, Polynomial.eval_mul, hz, zero_mul]

private theorem norm_int_discr_eq_prod_derivative (f : Polynomial ℤ) (hf : f.Monic) :
    let F := f.map (Int.castRingHom ℂ)
    ‖(f.discr : ℂ)‖ = (F.roots.map (fun x => ‖F.derivative.eval x‖)).prod := by
  classical
  let φ := Int.castRingHom ℂ
  let F := f.map φ
  change ‖(f.discr : ℂ)‖ = (F.roots.map (fun x => ‖F.derivative.eval x‖)).prod
  have hF : F.Monic := hf.map φ
  by_cases hz : f.natDegree = 0
  · obtain rfl := eq_one_of_monic_natDegree_zero hf hz
    have hd1 : (1 : Polynomial ℤ).discr = 1 := by simpa using Polynomial.discr_C (1 : ℤ)
    simp [F, hd1]
  have hd : F.natDegree = f.natDegree := hf.natDegree_map φ
  have hres : F.resultant F.derivative F.natDegree (F.natDegree - 1) =
      φ (f.resultant f.derivative f.natDegree (f.natDegree - 1)) := by
    rw [hd]
    change (f.map φ).resultant (f.map φ).derivative f.natDegree (f.natDegree - 1) = _
    rw [Polynomial.derivative_map, Polynomial.resultant_map_map]
  calc
    ‖(f.discr : ℂ)‖ = ‖F.resultant F.derivative F.natDegree (F.natDegree - 1)‖ := by
      rw [hres, Polynomial.resultant_deriv (natDegree_pos_iff_degree_pos.mp (Nat.pos_of_ne_zero hz)),
        hf.leadingCoeff]
      simp [φ, norm_pow]
    _ = _ := by
      rw [Polynomial.resultant_eq_prod_eval _ _ _ (Polynomial.natDegree_derivative_le _)
        (IsAlgClosed.splits _), hF.leadingCoeff, one_pow, one_mul, Multiset.norm_prod_map]

private theorem multiset_prod_le_pow {α : Type*} (s : Multiset α) (f : α → ℝ) (b : ℝ)
    (h₀ : ∀ i ∈ s, 0 ≤ f i) (h₁ : ∀ i ∈ s, f i ≤ b) : (s.map f).prod ≤ b ^ s.card := by
  simpa [Multiset.prod_replicate] using
    (Multiset.prod_map_le_prod_map₀ f (fun _ => b) h₀ h₁)

/-- The polynomial discriminant is bounded in terms of the degree and the
radius of a disk containing its roots. -/
theorem norm_int_poly_discr_le_of_bounded_roots (f : Polynomial ℤ) (hf : f.Monic)
    {N : ℝ} (hroot : ∀ z : ℂ, (f.map (Int.castRingHom ℂ)).IsRoot z → ‖z‖ ≤ N) :
    ‖(f.discr : ℂ)‖ ≤ (2 * N) ^ (f.natDegree * (f.natDegree - 1)) := by
  classical
  let F := f.map (Int.castRingHom ℂ)
  have hF : F.Monic := hf.map _
  have hs : F.Splits := IsAlgClosed.splits _
  have hcard : F.roots.card = f.natDegree := hs.natDegree_eq_card_roots.symm.trans (hf.natDegree_map _)
  have hb (x : ℂ) (hx : x ∈ F.roots) : ‖x‖ ≤ N :=
    hroot x (Polynomial.isRoot_of_mem_roots hx)
  have hd (x : ℂ) (hx : x ∈ F.roots) : ‖F.derivative.eval x‖ ≤ (2 * N) ^ (f.natDegree - 1) := by
    rw [hs.eval_root_derivative hF hx, Multiset.norm_prod_map]
    have hbound := multiset_prod_le_pow (F.roots.erase x) (fun y : ℂ => ‖x - y‖) (2 * N)
      (fun _ _ => norm_nonneg _) (fun y hy => by
        calc
          _ ≤ ‖x‖ + ‖y‖ := norm_sub_le _ _
          _ ≤ N + N := add_le_add (hb x hx) (hb y (Multiset.mem_of_mem_erase hy))
          _ = _ := (two_mul _).symm)
    simpa [Multiset.card_erase_of_mem hx, hcard, Nat.pred_eq_sub_one] using hbound
  rw [norm_int_discr_eq_prod_derivative f hf]
  change (F.roots.map (fun x => ‖F.derivative.eval x‖)).prod ≤ _
  calc
    _ ≤ ((2 * N) ^ (f.natDegree - 1)) ^ F.roots.card :=
      multiset_prod_le_pow _ _ _ (fun _ _ => norm_nonneg _) hd
    _ = _ := by rw [hcard, ← pow_mul, Nat.mul_comm]

/-- A monic integer polynomial with separable complex image has nonzero
integer discriminant. -/
theorem int_poly_discr_ne_zero_of_separable_map (f : Polynomial ℤ) (hf : f.Monic)
    (hsep : (f.map (Int.castRingHom ℂ)).Separable) : f.discr ≠ 0 := by
  classical
  let F := f.map (Int.castRingHom ℂ)
  have hnonzero : (F.roots.map (fun x => ‖F.derivative.eval x‖)).prod ≠ 0 := by
    apply Multiset.prod_ne_zero
    intro hm
    obtain ⟨x, hx, hnorm⟩ := Multiset.mem_map.mp hm
    have hroot : F.eval x = 0 := Polynomial.isRoot_of_mem_roots hx
    have hd : F.derivative.eval x ≠ 0 := hsep.eval₂_derivative_ne_zero (RingHom.id ℂ) hroot
    exact hd (norm_eq_zero.mp hnorm)
  intro hz
  have hnorm := norm_int_discr_eq_prod_derivative f hf
  rw [hz, Int.cast_zero, norm_zero] at hnorm
  exact hnonzero hnorm.symm

/-- A monic polynomial dividing the characteristic polynomial of a symmetric
integer sign matrix has the logarithmic discriminant bound for its degree. -/
theorem log_abs_int_poly_discr_le_of_dvd_charpoly {ι : Type*} [Fintype ι] [DecidableEq ι]
    {A : Matrix ι ι ℤ} (hS : A.IsSymm) (hA : ∀ i j, A i j = -1 ∨ A i j = 1)
    (f : Polynomial ℤ) (hf : f.Monic) (hdiv : f ∣ A.charpoly) (hdisc : f.discr ≠ 0) :
    Real.log |(f.discr : ℝ)| ≤ (f.natDegree * (f.natDegree - 1) : ℕ) *
      Real.log (2 * Fintype.card ι) := by
  obtain ⟨g, hg⟩ := hdiv
  have hroot (z : ℂ) (hz : (f.map (Int.castRingHom ℂ)).IsRoot z) :
      ‖z‖ ≤ (Fintype.card ι : ℝ) := by
    refine (roots_of_symmetric_sign_matrix hS hA (z := z) ?_).2
    rw [hg, Polynomial.map_mul, Polynomial.IsRoot.def, Polynomial.eval_mul,
      Polynomial.IsRoot.def.mp hz, zero_mul]
  have hb := norm_int_poly_discr_le_of_bounded_roots f hf hroot
  rw [Complex.norm_intCast] at hb
  have hpos : 0 < |(f.discr : ℝ)| := abs_pos.mpr (by exact_mod_cast hdisc)
  exact (Real.log_le_log hpos hb).trans_eq (Real.log_pow _ _)

end Bernoulli
