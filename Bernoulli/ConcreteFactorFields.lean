module

public import Bernoulli.DedekindRoots
public import Bernoulli.FactorFields
public import Bernoulli.IntegralFactors

import Mathlib.FieldTheory.Separable
import Mathlib.RingTheory.PrincipalIdealDomain

/-! Integral factors, quotient number fields, and power bases of a sampled matrix. -/

public section

open NumberField Polynomial UniqueFactorizationMonoid
open scoped BigOperators

namespace Bernoulli.ConcreteFactorFields

/-- Indices for the distinct rational irreducible factors of the characteristic polynomial. -/
noncomputable abbrev Index {n : ℕ} (a : Sample n) := factorSet (matrix a).charpoly

/-- The monic integral lift of the factor at this index. -/
noncomputable def integralFactor {n : ℕ} (a : Sample n) : Index a → Polynomial ℤ :=
  Classical.choose (exists_integral_factorization (matrix a).charpoly (matrix a).charpoly_monic)

private theorem integralFactor_spec {n : ℕ} (a : Sample n) :
    (matrix a).charpoly = ∏ q : Index a,
      integralFactor a q ^ factorMultiplicity (matrix a).charpoly q ∧
    Function.Injective (integralFactor a) ∧
    ∀ q, (integralFactor a q).Monic ∧ Irreducible (integralFactor a q) ∧
      (integralFactor a q).map (algebraMap ℤ ℚ) = q.1 :=
  Classical.choose_spec
    (exists_integral_factorization (matrix a).charpoly (matrix a).charpoly_monic)

theorem factorization {n : ℕ} (a : Sample n) :
    (matrix a).charpoly = ∏ q : Index a,
      integralFactor a q ^ factorMultiplicity (matrix a).charpoly q :=
  (integralFactor_spec a).1

theorem integralFactor_monic {n : ℕ} (a : Sample n) (q : Index a) :
    (integralFactor a q).Monic := ((integralFactor_spec a).2.2 q).1

theorem integralFactor_map_rat {n : ℕ} (a : Sample n) (q : Index a) :
    (integralFactor a q).map (algebraMap ℤ ℚ) = q.1 := ((integralFactor_spec a).2.2 q).2.2

theorem factorProduct_dvd_charpoly {n : ℕ} (a : Sample n) :
    (∏ q : Index a, integralFactor a q) ∣ (matrix a).charpoly := by
  rw [factorization a]
  exact Finset.prod_dvd_prod_of_dvd _ _ fun q _ =>
    dvd_pow_self _ (factorMultiplicity_pos (matrix a).charpoly q).ne'

theorem integralFactor_dvd_charpoly {n : ℕ} (a : Sample n) (q : Index a) :
    integralFactor a q ∣ (matrix a).charpoly :=
  (Finset.dvd_prod_of_mem _ (Finset.mem_univ q)).trans (factorProduct_dvd_charpoly a)

private theorem irreducible_index {n : ℕ} (a : Sample n) (q : Index a) :
    Irreducible (q : Polynomial ℚ) := by
  classical
  exact ((Polynomial.mem_normalizedFactors_iff
    ((matrix a).charpoly_monic.map (algebraMap ℤ ℚ)).ne_zero).mp (Multiset.mem_toFinset.mp q.2)).1

instance {n : ℕ} (a : Sample n) (q : Index a) :
    Fact (Irreducible ((integralFactor a q).map (algebraMap ℤ ℚ))) :=
  ⟨(integralFactor_map_rat a q).symm ▸ irreducible_index a q⟩

/-- The number field generated by the rational irreducible factor. -/
abbrev RootField {n : ℕ} (a : Sample n) (q : Index a) := FactorField (integralFactor a q)

/-- The power basis given by the class of the indeterminate in the factor field. -/
noncomputable def powerBasis {n : ℕ} (a : Sample n) (q : Index a) :
    PowerBasis ℚ (RootField a q) :=
  AdjoinRoot.powerBasis ((integralFactor_monic a q).map (algebraMap ℤ ℚ)).ne_zero

/-- The class of the indeterminate is an algebraic integer. -/
@[expose] noncomputable def integerGenerator {n : ℕ} (a : Sample n) (q : Index a) :
    𝓞 (RootField a q) :=
  ⟨(powerBasis a q).gen, ⟨integralFactor a q, integralFactor_monic a q, by
    rw [powerBasis, AdjoinRoot.powerBasis_gen]
    exact aeval_factorField_root _⟩⟩

theorem powerBasis_gen {n : ℕ} (a : Sample n) (q : Index a) :
    (powerBasis a q).gen = (integerGenerator a q : RootField a q) := rfl

theorem minpoly_powerBasis_gen {n : ℕ} (a : Sample n) (q : Index a) :
    minpoly ℚ (powerBasis a q).gen = (integralFactor a q).map (algebraMap ℤ ℚ) :=
  AdjoinRoot.minpoly_powerBasis_gen_of_monic ((integralFactor_monic a q).map (algebraMap ℤ ℚ))

theorem minpoly_integerGenerator {n : ℕ} (a : Sample n) (q : Index a) :
    minpoly ℤ (integerGenerator a q : RootField a q) = integralFactor a q := by
  apply Polynomial.map_injective (algebraMap ℤ ℚ) (IsFractionRing.injective ℤ ℚ)
  have hint : IsIntegral ℤ (integerGenerator a q : RootField a q) :=
    RingOfIntegers.isIntegral_coe (integerGenerator a q)
  calc
    _ = minpoly ℚ (integerGenerator a q : RootField a q) :=
      (minpoly.isIntegrallyClosed_eq_field_fractions' ℚ hint).symm
    _ = minpoly ℚ (powerBasis a q).gen := congrArg (minpoly ℚ) (powerBasis_gen a q).symm
    _ = _ := minpoly_powerBasis_gen a q

private theorem exists_powerDiscriminant {n : ℕ} (a : Sample n) (q : Index a) :
    ∃ d : ℤ, Algebra.discr ℚ (powerBasis a q).basis = (d : ℚ) := by
  obtain ⟨k, hk⟩ := exists_powerBasis_discriminant_eq_fieldDiscr_mul_sq
    (powerBasis a q) (integerGenerator a q) (powerBasis_gen a q)
  exact ⟨_, hk⟩

/-- The signed integer discriminant of the power basis of the factor field. -/
noncomputable def powerDiscriminant {n : ℕ} (a : Sample n) (q : Index a) : ℤ :=
  Classical.choose (exists_powerDiscriminant a q)

theorem powerDiscriminant_spec {n : ℕ} (a : Sample n) (q : Index a) :
    Algebra.discr ℚ (powerBasis a q).basis = (powerDiscriminant a q : ℚ) :=
  Classical.choose_spec (exists_powerDiscriminant a q)

theorem powerDiscriminant_ne_zero {n : ℕ} (a : Sample n) (q : Index a) :
    powerDiscriminant a q ≠ 0 := by
  intro hz
  apply Algebra.discr_not_zero_of_basis ℚ (powerBasis a q).basis
  rw [powerDiscriminant_spec, hz, Int.cast_zero]

theorem fieldDegree_eq_natDegree {n : ℕ} (a : Sample n) (q : Index a) :
    Module.finrank ℚ (RootField a q) = (integralFactor a q).natDegree :=
  finrank_factorField (integralFactor_monic a q)

theorem sum_weighted_fieldDegree {n : ℕ} (a : Sample n) :
    (∑ q : Index a, factorMultiplicity (matrix a).charpoly q *
      Module.finrank ℚ (RootField a q)) = n := by
  simp_rw [fieldDegree_eq_natDegree]
  exact (sum_weighted_natDegree (integralFactor_monic a) (factorization a)).trans
    (by simp)

/-- The product of the distinct integral factors is separable after mapping to the rationals. -/
theorem separable_factorProduct_map_rat {n : ℕ} (a : Sample n) :
    ((∏ q : Index a, integralFactor a q).map (algebraMap ℤ ℚ)).Separable := by
  rw [Polynomial.map_prod]
  simp only [integralFactor_map_rat]
  refine Polynomial.separable_prod ?_ (fun q => (irreducible_index a q).separable)
  intro i j hij
  rcases (irreducible_index a i).isCoprime_or_dvd (j : Polynomial ℚ) with h | h
  · exact h
  · exfalso
    apply hij
    apply Subtype.ext
    have hii := (integralFactor_monic a i).map (algebraMap ℤ ℚ)
    have hjj := (integralFactor_monic a j).map (algebraMap ℤ ℚ)
    rw [integralFactor_map_rat] at hii hjj
    have heq := normalize_eq_normalize_iff_associated.mpr
      ((irreducible_index a i).associated_of_dvd (irreducible_index a j) h)
    simpa only [hii.normalize_eq_self, hjj.normalize_eq_self] using heq

/-- The product of the distinct integral factors is separable after mapping to the complexes. -/
theorem separable_factorProduct_map_complex {n : ℕ} (a : Sample n) :
    ((∏ q : Index a, integralFactor a q).map (Int.castRingHom ℂ)).Separable := by
  have h := (separable_factorProduct_map_rat a).map (f := algebraMap ℚ ℂ)
  rwa [Polynomial.map_map,
    RingHom.eq_intCast' ((algebraMap ℚ ℂ).comp (algebraMap ℤ ℚ))] at h

end Bernoulli.ConcreteFactorFields
